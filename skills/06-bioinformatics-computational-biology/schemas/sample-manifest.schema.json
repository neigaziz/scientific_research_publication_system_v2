{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bioinformatics sample manifest",
  "type": "object",
  "required": [
    "project_id",
    "organism",
    "assay",
    "reference_build",
    "samples"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "organism": {
      "type": "string"
    },
    "assay": {
      "type": "string"
    },
    "platform": {
      "type": [
        "string",
        "null"
      ]
    },
    "read_layout": {
      "enum": [
        "single_end",
        "paired_end",
        "long_read",
        "not_applicable",
        "unknown"
      ]
    },
    "reference_build": {
      "type": "string"
    },
    "annotation_release": {
      "type": [
        "string",
        "null"
      ]
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sample_id",
          "file_paths"
        ],
        "properties": {
          "sample_id": {
            "type": "string"
          },
          "biological_group": {
            "type": [
              "string",
              "null"
            ]
          },
          "replicate": {
            "type": [
              "string",
              "integer",
              "null"
            ]
          },
          "file_paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "checksum_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "metadata": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
