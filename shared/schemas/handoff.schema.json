{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Handoff",
  "type": "object",
  "required": [
    "task_id",
    "objective",
    "assigned_agent",
    "required_skills",
    "expected_outputs",
    "status"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "assigned_agent": {
      "enum": [
        "A1",
        "A2",
        "A3",
        "A4"
      ]
    },
    "required_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "version"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "expected_outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_type",
          "acceptance_criteria"
        ],
        "properties": {
          "artifact_type": {
            "type": "string"
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_gate": {
      "enum": [
        "none",
        "H1",
        "H2",
        "H3",
        "H4",
        "H5",
        "H6",
        "H7",
        "H8"
      ]
    },
    "status": {
      "enum": [
        "not_started",
        "ready",
        "in_progress",
        "blocked",
        "completed_with_warnings",
        "validated",
        "approved",
        "failed",
        "superseded"
      ]
    }
  },
  "additionalProperties": true
}
