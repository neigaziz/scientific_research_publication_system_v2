{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Result Claim",
  "type": "object",
  "required": [
    "claim_id",
    "claim_text",
    "evidence_type",
    "source_artifact_ids",
    "status"
  ],
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "claim_text": {
      "type": "string"
    },
    "evidence_type": {
      "enum": [
        "observed",
        "estimated",
        "associated",
        "causal",
        "hypothesis",
        "interpretation"
      ]
    },
    "estimate": {
      "type": [
        "number",
        "null"
      ]
    },
    "standard_error": {
      "type": [
        "number",
        "null"
      ]
    },
    "confidence_interval": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "units": {
      "type": [
        "string",
        "null"
      ]
    },
    "p_value": {
      "type": [
        "number",
        "null"
      ]
    },
    "source_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "draft",
        "validated",
        "approved",
        "unsupported"
      ]
    }
  },
  "additionalProperties": true
}
